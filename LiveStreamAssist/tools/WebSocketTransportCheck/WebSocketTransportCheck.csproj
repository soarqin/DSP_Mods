<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>WebSocketTransportCheck</AssemblyName>
    <RootNamespace>WebSocketTransportCheck</RootNamespace>
    <BepInExPluginGuid>org.soardev.livestreamassist.transportcheck</BepInExPluginGuid>
    <PackPreloaderTargetDir>none</PackPreloaderTargetDir>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LiveStreamAssist.csproj" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <!-- Desktop checks need the CLR's 2.0 facade for Kestrel, not Unity's Mono 2.1 type forwarders. -->
  <Target Name="KeepRuntimeSpecificFacades" BeforeTargets="GenerateBindingRedirects">
    <ItemGroup>
      <SuggestedBindingRedirects Remove="netstandard,*" />
    </ItemGroup>
  </Target>
  <Target Name="CopyGameFacades" AfterTargets="Build">
    <Copy SourceFiles="@(ReferencePath)" DestinationFolder="$(TargetDir)"
          Condition="'%(ReferencePath.Filename)' == 'BepInEx'" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\ReflectionReaderCheck\Copy-GameFacades.ps1&quot; -TargetDir &quot;$(TargetDir).&quot;" />
  </Target>
</Project>
